{
 "bobo-179c123e10": {
  "text": "Assalomu alaykum, bolam! Men Hikmat boboman.",
  "voice": "bobo",
  "file": "audio/uz/bobo-179c123e10.mp3",
  "sec": 3.53
 },
 "bobo-cc861723f0": {
  "text": "Yovuz dev Bilim kitobini o'g'irladi. Keling, uni birga qaytaramiz!",
  "voice": "bobo",
  "file": "audio/uz/bobo-cc861723f0.mp3",
  "sec": 5.23
 },
 "bobo-9296d18e3f": {
  "text": "Yonib turgan nuqtani bos. Sayohat o'sha yerdan boshlanadi.",
  "voice": "bobo",
  "file": "audio/uz/bobo-9296d18e3f.mp3",
  "sec": 4.8
 },
 "bobo-a3ca582362": {
  "text": "Bu yo'l hali tayyorlanmoqda. Tez orada ochiladi!",
  "voice": "bobo",
  "file": "audio/uz/bobo-a3ca582362.mp3",
  "sec": 3.96
 },
 "bobo-db35850b89": {
  "text": "Avval oldingi to'siqni yengamiz, bolam.",
  "voice": "bobo",
  "file": "audio/uz/bobo-db35850b89.mp3",
  "sec": 3.19
 },
 "bobo-8380e221dd": {
  "text": "Bolam, qishloq darvozasi qulflangan. Bizga kalit kerak. Kalitni uch qismdan yig'amiz!",
  "voice": "bobo",
  "file": "audio/uz/bobo-8380e221dd.mp3",
  "sec": 7.13
 },
 "bobo-05df793fd9": {
  "text": "Harflardan so'z tuzamiz. To'g'ri so'zni bos.",
  "voice": "bobo",
  "file": "audio/uz/bobo-05df793fd9.mp3",
  "sec": 3.19
 },
 "bobo-91ea86d397": {
  "text": "Rasm bo'laklarga bo'lindi. Ikki bo'lakni bosib, o'rnini almashtir.",
  "voice": "bobo",
  "file": "audio/uz/bobo-91ea86d397.mp3",
  "sec": 5.33
 },
 "bobo-7b7e38c732": {
  "text": "Topishmoqni diqqat bilan o'qi. Javobini top.",
  "voice": "bobo",
  "file": "audio/uz/bobo-7b7e38c732.mp3",
  "sec": 3.58
 },
 "bobo-4f84a634b0": {
  "text": "Bu qo'shimcha sinov. Maqollarni yaxshi bilasanmi?",
  "voice": "bobo",
  "file": "audio/uz/bobo-4f84a634b0.mp3",
  "sec": 4.18
 },
 "bobo-cd03fa7898": {
  "text": "Bu qo'shimcha sinov. So'z turkumlarini eslaymiz.",
  "voice": "bobo",
  "file": "audio/uz/bobo-cd03fa7898.mp3",
  "sec": 3.82
 },
 "bobo-1b6ec27930": {
  "text": "Kalit tayyor! Uni sumkadan darvoza qulfiga olib bor.",
  "voice": "bobo",
  "file": "audio/uz/bobo-1b6ec27930.mp3",
  "sec": 4.42
 },
 "bobo-17b0aedbcc": {
  "text": "Barakalla! Darvoza ochildi. Oldinda qorong'i o'rmon kutmoqda.",
  "voice": "bobo",
  "file": "audio/uz/bobo-17b0aedbcc.mp3",
  "sec": 4.92
 },
 "bobo-b7dc7ffc52": {
  "text": "Barakalla, bolam!",
  "voice": "bobo",
  "file": "audio/uz/bobo-b7dc7ffc52.mp3",
  "sec": 1.8
 },
 "bobo-03546cd6c3": {
  "text": "Ofarin! Juda to'g'ri, bolam!",
  "voice": "bobo",
  "file": "audio/uz/bobo-03546cd6c3.mp3",
  "sec": 2.35
 },
 "bobo-14db496291": {
  "text": "Juda zo'r! Davom etamiz.",
  "voice": "bobo",
  "file": "audio/uz/bobo-14db496291.mp3",
  "sec": 2.09
 },
 "bobo-56ab6f9306": {
  "text": "Qoyil! Aqlingga balli.",
  "voice": "bobo",
  "file": "audio/uz/bobo-56ab6f9306.mp3",
  "sec": 2.16
 },
 "bobo-10ec58f7f3": {
  "text": "Hechqisi yo'q, yana urinib ko'r.",
  "voice": "bobo",
  "file": "audio/uz/bobo-10ec58f7f3.mp3",
  "sec": 2.52
 },
 "bobo-30b357cdeb": {
  "text": "Men yoningdaman. Yana bir bor!",
  "voice": "bobo",
  "file": "audio/uz/bobo-30b357cdeb.mp3",
  "sec": 2.62
 },
 "bobo-39f006c60b": {
  "text": "Shoshilma, yaxshilab o'ylab ko'r.",
  "voice": "bobo",
  "file": "audio/uz/bobo-39f006c60b.mp3",
  "sec": 2.66
 },
 "bobo-301feba7d9": {
  "text": "Sabr tagi — sariq oltin. Yana urin!",
  "voice": "bobo",
  "file": "audio/uz/bobo-301feba7d9.mp3",
  "sec": 2.64
 },
 "bobo-50bd9109bf": {
  "text": "Bir maslahat beraymi? Sariq tugmani bos.",
  "voice": "bobo",
  "file": "audio/uz/bobo-50bd9109bf.mp3",
  "sec": 3.46
 },
 "bobo-6223bfe2d4": {
  "text": "Maslahatlar tugadi. Sen o'zing uddalaysan!",
  "voice": "bobo",
  "file": "audio/uz/bobo-6223bfe2d4.mp3",
  "sec": 3.5
 },
 "bobo-f9d55cc2e3": {
  "text": "Qiyin bo'lsa, menga bos. Yordam beraman.",
  "voice": "bobo",
  "file": "audio/uz/bobo-f9d55cc2e3.mp3",
  "sec": 3.02
 },
 "bobo-fb617f14ec": {
  "text": "Yangi qism sumkaga tushdi!",
  "voice": "bobo",
  "file": "audio/uz/bobo-fb617f14ec.mp3",
  "sec": 2.33
 },
 "bobo-8f8e3af40a": {
  "text": "Qo'shimcha sinov ham bajarildi. Qoyil!",
  "voice": "bobo",
  "file": "audio/uz/bobo-8f8e3af40a.mp3",
  "sec": 3.14
 },
 "bobo-9ff08e1fef": {
  "text": "Mana, kaliting tayyor! Endi darvozani ochamiz.",
  "voice": "bobo",
  "file": "audio/uz/bobo-9ff08e1fef.mp3",
  "sec": 3.77
 },
 "bobo-8942f453d5": {
  "text": "Yana urinib ko'ramizmi? Uchinchi yulduz kutyapti!",
  "voice": "bobo",
  "file": "audio/uz/bobo-8942f453d5.mp3",
  "sec": 4.1
 },
 "bobo-2f18c29ee7": {
  "text": "Butun rasmga qarab ol. Keyin yig'amiz.",
  "voice": "bobo",
  "file": "audio/uz/bobo-2f18c29ee7.mp3",
  "sec": 3.0
 },
 "bobo-0a5a1bfaa6": {
  "text": "O'rmon juda qorong'i, bolam. Mash'al yasaymiz! Uch qism kerak.",
  "voice": "bobo",
  "file": "audio/uz/bobo-0a5a1bfaa6.mp3",
  "sec": 4.8
 },
 "bobo-5703a08976": {
  "text": "Kartalarni ochib, juftini top. Yaxshilab eslab qol!",
  "voice": "bobo",
  "file": "audio/uz/bobo-5703a08976.mp3",
  "sec": 4.37
 },
 "bobo-0ed5dc545d": {
  "text": "O'rmon rasmini yig'amiz. Ikki bo'lakni bosib almashtir.",
  "voice": "bobo",
  "file": "audio/uz/bobo-0ed5dc545d.mp3",
  "sec": 4.37
 },
 "bobo-ccc698d242": {
  "text": "O'rmon jonivorlari haqida topishmoqlar. Diqqat bilan o'qi.",
  "voice": "bobo",
  "file": "audio/uz/bobo-ccc698d242.mp3",
  "sec": 4.8
 },
 "bobo-080ba5448c": {
  "text": "Hayvonlarni to'g'ri tartibga qo'y. Keyin tekshir.",
  "voice": "bobo",
  "file": "audio/uz/bobo-080ba5448c.mp3",
  "sec": 3.94
 },
 "bobo-a99f0adec5": {
  "text": "Bu qo'shimcha sinov. Tabiatni asrash haqida.",
  "voice": "bobo",
  "file": "audio/uz/bobo-a99f0adec5.mp3",
  "sec": 3.74
 },
 "bobo-dbe6732dc6": {
  "text": "Mash'al tayyor! Uni qorong'i o'rmonga olib bor.",
  "voice": "bobo",
  "file": "audio/uz/bobo-dbe6732dc6.mp3",
  "sec": 3.86
 },
 "bobo-284c11e2a9": {
  "text": "Mana, mash'aling tayyor! Endi o'rmonni yoritamiz.",
  "voice": "bobo",
  "file": "audio/uz/bobo-284c11e2a9.mp3",
  "sec": 3.72
 },
 "bobo-dab4f6362d": {
  "text": "O'rmon yorishdi! Oldinda katta daryo kutmoqda.",
  "voice": "bobo",
  "file": "audio/uz/bobo-dab4f6362d.mp3",
  "sec": 3.98
 },
 "bobo-acce204f21": {
  "text": "Bolam, oldimizda katta daryo. Qayiqsiz o'tolmaymiz. Keling, qayiq yasaymiz!",
  "voice": "bobo",
  "file": "audio/uz/bobo-acce204f21.mp3",
  "sec": 5.86
 },
 "bobo-a7ca82cea2": {
  "text": "Bu krossvordda sonlar yashiringan. Har biri qayiqqa yordam beradi.",
  "voice": "bobo",
  "file": "audio/uz/bobo-a7ca82cea2.mp3",
  "sec": 5.33
 },
 "bobo-b31bbf4ab5": {
  "text": "Daryo rasmini yig'amiz. Bo'laklarni joyiga qo'y.",
  "voice": "bobo",
  "file": "audio/uz/bobo-b31bbf4ab5.mp3",
  "sec": 3.74
 },
 "bobo-5a7e47f856": {
  "text": "Misollarni yechamiz. Shoshilmay hisobla.",
  "voice": "bobo",
  "file": "audio/uz/bobo-5a7e47f856.mp3",
  "sec": 3.29
 },
 "bobo-59b4010642": {
  "text": "Tartiblab chiq, keyin tekshir. Bu qo'shimcha sinov.",
  "voice": "bobo",
  "file": "audio/uz/bobo-59b4010642.mp3",
  "sec": 4.25
 },
 "bobo-cea71890bf": {
  "text": "Bu olimlar uchun masalalar. Qog'ozda yechib ko'r.",
  "voice": "bobo",
  "file": "audio/uz/bobo-cea71890bf.mp3",
  "sec": 3.84
 },
 "bobo-12cb2ae84a": {
  "text": "Qayiq tayyor! Uni daryoga sudrab olib bor.",
  "voice": "bobo",
  "file": "audio/uz/bobo-12cb2ae84a.mp3",
  "sec": 3.12
 },
 "bobo-5bb2cd89e0": {
  "text": "Mana, qayig'ing tayyor! Endi daryodan suzib o'tamiz.",
  "voice": "bobo",
  "file": "audio/uz/bobo-5bb2cd89e0.mp3",
  "sec": 4.06
 },
 "bobo-3eed17f59c": {
  "text": "Daryodan o'tdik! Endi Qizilqum cho'li kutmoqda.",
  "voice": "bobo",
  "file": "audio/uz/bobo-3eed17f59c.mp3",
  "sec": 3.77
 },
 "bobo-a73248b329": {
  "text": "Cho'l yo'li uzoq, suv yo'q. Ot va mesh kerak!",
  "voice": "bobo",
  "file": "audio/uz/bobo-a73248b329.mp3",
  "sec": 3.17
 },
 "bobo-7146f41eaa": {
  "text": "To'g'ri yo'lni topamiz. Savolni diqqat bilan o'qi.",
  "voice": "bobo",
  "file": "audio/uz/bobo-7146f41eaa.mp3",
  "sec": 3.98
 },
 "bobo-56f19f15c0": {
  "text": "Cho'l rasmini yig'amiz. Shoshilmasdan joyla.",
  "voice": "bobo",
  "file": "audio/uz/bobo-56f19f15c0.mp3",
  "sec": 3.62
 },
 "bobo-9d42012ba5": {
  "text": "Geografik krossvord. Savolni bos va javobni yoz.",
  "voice": "bobo",
  "file": "audio/uz/bobo-9d42012ba5.mp3",
  "sec": 3.62
 },
 "bobo-c59634975c": {
  "text": "Kartalarni ochib, juftini top. Bu qo'shimcha sinov.",
  "voice": "bobo",
  "file": "audio/uz/bobo-c59634975c.mp3",
  "sec": 4.25
 },
 "bobo-04c8a53753": {
  "text": "Daryolarni tartiblang. Bu qo'shimcha sinov.",
  "voice": "bobo",
  "file": "audio/uz/bobo-04c8a53753.mp3",
  "sec": 3.5
 },
 "bobo-4cc15999d8": {
  "text": "Ot ham, mesh ham tayyor! Ularni cho'lga olib bor.",
  "voice": "bobo",
  "file": "audio/uz/bobo-4cc15999d8.mp3",
  "sec": 3.67
 },
 "bobo-bac79cc2f1": {
  "text": "Otimiz egarlandi, meshimiz to'la! Cho'ldan o'tamiz.",
  "voice": "bobo",
  "file": "audio/uz/bobo-bac79cc2f1.mp3",
  "sec": 4.01
 },
 "bobo-c13aee7b2b": {
  "text": "Cho'ldan eson-omon o'tdik. Oldinda baland tog'.",
  "voice": "bobo",
  "file": "audio/uz/bobo-c13aee7b2b.mp3",
  "sec": 3.67
 },
 "bobo-02e70364b8": {
  "text": "Tog'da chuqur jarlik bor. Arqon kerak, bolam!",
  "voice": "bobo",
  "file": "audio/uz/bobo-02e70364b8.mp3",
  "sec": 3.5
 },
 "bobo-e1c587d3ed": {
  "text": "Bosh qotirmalar! Yaxshilab o'ylab, javobni tanla.",
  "voice": "bobo",
  "file": "audio/uz/bobo-e1c587d3ed.mp3",
  "sec": 4.03
 },
 "bobo-0eee53dd63": {
  "text": "Qadamlarni to'g'ri tartibga qo'y. Keyin tekshir.",
  "voice": "bobo",
  "file": "audio/uz/bobo-0eee53dd63.mp3",
  "sec": 4.06
 },
 "bobo-bac3002623": {
  "text": "Tog' rasmini yig'amiz. Bo'laklarni almashtir.",
  "voice": "bobo",
  "file": "audio/uz/bobo-bac3002623.mp3",
  "sec": 3.65
 },
 "bobo-1e912088a4": {
  "text": "Juftlarni top. Bu qo'shimcha sinov.",
  "voice": "bobo",
  "file": "audio/uz/bobo-1e912088a4.mp3",
  "sec": 2.95
 },
 "bobo-7ac9f59f28": {
  "text": "Informatika krossvordi. Bu qo'shimcha sinov.",
  "voice": "bobo",
  "file": "audio/uz/bobo-7ac9f59f28.mp3",
  "sec": 3.86
 },
 "bobo-280abf41b8": {
  "text": "Arqon tayyor! Uni jarlikka tashla.",
  "voice": "bobo",
  "file": "audio/uz/bobo-280abf41b8.mp3",
  "sec": 2.95
 },
 "bobo-f392322a07": {
  "text": "Uch bo'lak tugun bilan bog'landi. Arqon tayyor!",
  "voice": "bobo",
  "file": "audio/uz/bobo-f392322a07.mp3",
  "sec": 3.89
 },
 "bobo-e583ef8a00": {
  "text": "Jarlikdan o'tdik! Endi dev g'ori yaqin.",
  "voice": "bobo",
  "file": "audio/uz/bobo-e583ef8a00.mp3",
  "sec": 3.07
 },
 "bobo-0fc3ea69a0": {
  "text": "Bu dev g'ori. Qilich va qalqon kerak bo'ladi.",
  "voice": "bobo",
  "file": "audio/uz/bobo-0fc3ea69a0.mp3",
  "sec": 3.46
 },
 "bobo-7b73a94464": {
  "text": "Voqealarni vaqt bo'yicha tartibla. Keyin tekshir.",
  "voice": "bobo",
  "file": "audio/uz/bobo-7b73a94464.mp3",
  "sec": 4.1
 },
 "bobo-2dc1a9f46c": {
  "text": "G'or rasmini yig'amiz. Qo'rqma, men yoningdaman.",
  "voice": "bobo",
  "file": "audio/uz/bobo-2dc1a9f46c.mp3",
  "sec": 4.01
 },
 "bobo-8ca46c6db1": {
  "text": "Tarix savollari. O'tmishni bilgan yo'ldan adashmaydi.",
  "voice": "bobo",
  "file": "audio/uz/bobo-8ca46c6db1.mp3",
  "sec": 4.06
 },
 "bobo-c318db66fc": {
  "text": "Aralash savollar. Bu qo'shimcha sinov.",
  "voice": "bobo",
  "file": "audio/uz/bobo-c318db66fc.mp3",
  "sec": 2.95
 },
 "bobo-749a600013": {
  "text": "Dev savol beradi. To'g'ri javob — qilich zarbasi!",
  "voice": "bobo",
  "file": "audio/uz/bobo-749a600013.mp3",
  "sec": 3.89
 },
 "bobo-1fda24ddae": {
  "text": "Qilich ham, qalqon ham tayyor! Endi devning oldiga boramiz.",
  "voice": "bobo",
  "file": "audio/uz/bobo-1fda24ddae.mp3",
  "sec": 4.7
 },
 "bobo-4f0e7343d6": {
  "text": "Dev yengildi! Endi dev qal'asiga boramiz.",
  "voice": "bobo",
  "file": "audio/uz/bobo-4f0e7343d6.mp3",
  "sec": 3.26
 },
 "bobo-b4f11a4fb1": {
  "text": "Bu dev qal'asi. Darvoza sehrlangan. Sehrli tumor kerak!",
  "voice": "bobo",
  "file": "audio/uz/bobo-b4f11a4fb1.mp3",
  "sec": 4.51
 },
 "bobo-3d08c69699": {
  "text": "Hamma bilganingni esla. Savolni diqqat bilan o'qi.",
  "voice": "bobo",
  "file": "audio/uz/bobo-3d08c69699.mp3",
  "sec": 4.01
 },
 "bobo-602df43059": {
  "text": "Butun sayohatimizni eslaymiz. Juftini top.",
  "voice": "bobo",
  "file": "audio/uz/bobo-602df43059.mp3",
  "sec": 3.5
 },
 "bobo-64443e9095": {
  "text": "Bilim kitobi sahifalari yirtilgan. Ularni yig'amiz!",
  "voice": "bobo",
  "file": "audio/uz/bobo-64443e9095.mp3",
  "sec": 4.3
 },
 "bobo-4212d5b1cd": {
  "text": "Matematika va geografiya. Bu qo'shimcha sinov.",
  "voice": "bobo",
  "file": "audio/uz/bobo-4212d5b1cd.mp3",
  "sec": 3.91
 },
 "bobo-0c282c5581": {
  "text": "Karvon yo'lini tartiblang. Bu qo'shimcha sinov.",
  "voice": "bobo",
  "file": "audio/uz/bobo-0c282c5581.mp3",
  "sec": 3.89
 },
 "bobo-be60d5e2e7": {
  "text": "Tumor tayyor! Uni sehrlangan darvozaga olib bor.",
  "voice": "bobo",
  "file": "audio/uz/bobo-be60d5e2e7.mp3",
  "sec": 3.82
 },
 "bobo-9a5f682a1f": {
  "text": "Sehrli tumor tayyor! Endi darvozani ochamiz.",
  "voice": "bobo",
  "file": "audio/uz/bobo-9a5f682a1f.mp3",
  "sec": 3.58
 },
 "bobo-787e2531d2": {
  "text": "Bilim kitobi qaytdi! Maktablarda harflar yana yondi. Rahmat, bolam!",
  "voice": "bobo",
  "file": "audio/uz/bobo-787e2531d2.mp3",
  "sec": 5.47
 },
 "bobo-f96383a3d3": {
  "text": "Qalqon seni himoya qildi! Yana urin.",
  "voice": "bobo",
  "file": "audio/uz/bobo-f96383a3d3.mp3",
  "sec": 2.83
 },
 "bobo-773c2164c7": {
  "text": "Dev yengildi! Bilim kitobi bizniki.",
  "voice": "bobo",
  "file": "audio/uz/bobo-773c2164c7.mp3",
  "sec": 2.9
 },
 "bobo-c39136ef8c": {
  "text": "Devning sehri sindi! U kechirim so'rab qochdi.",
  "voice": "bobo",
  "file": "audio/uz/bobo-c39136ef8c.mp3",
  "sec": 3.58
 },
 "bobo-ae35ffccf7": {
  "text": "2 + 3 = ?",
  "voice": "bobo",
  "file": "audio/uz/bobo-ae35ffccf7.mp3",
  "sec": 2.57
 },
 "bobo-6b18bce483": {
  "text": "10 − 6 = ?",
  "voice": "bobo",
  "file": "audio/uz/bobo-6b18bce483.mp3",
  "sec": 2.52
 },
 "bobo-72bb474fd4": {
  "text": "4 + 4 = ?",
  "voice": "bobo",
  "file": "audio/uz/bobo-72bb474fd4.mp3",
  "sec": 2.57
 },
 "bobo-8f2e733e7e": {
  "text": "1 + 1 = ?",
  "voice": "bobo",
  "file": "audio/uz/bobo-8f2e733e7e.mp3",
  "sec": 2.4
 },
 "bobo-6e05f17327": {
  "text": "9 − 8 = ?",
  "voice": "bobo",
  "file": "audio/uz/bobo-6e05f17327.mp3",
  "sec": 2.71
 },
 "bobo-2b782371c7": {
  "text": "Qayiqqa 3 ta taxta kerak, bizda 1 ta bor. Yana nechta kerak?",
  "voice": "bobo",
  "file": "audio/uz/bobo-2b782371c7.mp3",
  "sec": 5.06
 },
 "bobo-9960343882": {
  "text": "Uchdan birni ayir.",
  "voice": "bobo",
  "file": "audio/uz/bobo-9960343882.mp3",
  "sec": 1.61
 },
 "bobo-8385ef3033": {
  "text": "5 ta baliqdan 2 tasi suzib ketdi. Nechta qoldi?",
  "voice": "bobo",
  "file": "audio/uz/bobo-8385ef3033.mp3",
  "sec": 4.22
 },
 "bobo-bd86d91472": {
  "text": "Barmoqlaringda sanab ko'r.",
  "voice": "bobo",
  "file": "audio/uz/bobo-bd86d91472.mp3",
  "sec": 2.16
 },
 "bobo-c237707520": {
  "text": "Bitta eshkakni 2 qo'l ushlaydi. 2 ta eshkakni-chi?",
  "voice": "bobo",
  "file": "audio/uz/bobo-c237707520.mp3",
  "sec": 4.51
 },
 "bobo-323f41b25c": {
  "text": "2 ga yana 2 ni qo'sh.",
  "voice": "bobo",
  "file": "audio/uz/bobo-323f41b25c.mp3",
  "sec": 2.09
 },
 "bobo-34612fd863": {
  "text": "Inson hayoti bosqichlarini tartibla",
  "voice": "bobo",
  "file": "audio/uz/bobo-34612fd863.mp3",
  "sec": 3.0
 },
 "bobo-c3b15ed11e": {
  "text": "Eng kichik yoshdan boshla.",
  "voice": "bobo",
  "file": "audio/uz/bobo-c3b15ed11e.mp3",
  "sec": 2.28
 },
 "bobo-cc4c302fee": {
  "text": "O'zbekiston poytaxti qaysi shahar?",
  "voice": "bobo",
  "file": "audio/uz/bobo-cc4c302fee.mp3",
  "sec": 2.88
 },
 "bobo-d4a93c01dd": {
  "text": "Eng katta shahrimiz, metrosi bor.",
  "voice": "bobo",
  "file": "audio/uz/bobo-d4a93c01dd.mp3",
  "sec": 2.76
 },
 "bobo-18737b5fc9": {
  "text": "Registon qaysi shaharda?",
  "voice": "bobo",
  "file": "audio/uz/bobo-18737b5fc9.mp3",
  "sec": 2.33
 },
 "bobo-a6da86a089": {
  "text": "U yerda Ulug'bek rasadxonasi bor.",
  "voice": "bobo",
  "file": "audio/uz/bobo-a6da86a089.mp3",
  "sec": 2.9
 },
 "bobo-c4a46faa7f": {
  "text": "Mustaqillik kuni qachon nishonlanadi?",
  "voice": "bobo",
  "file": "audio/uz/bobo-c4a46faa7f.mp3",
  "sec": 2.98
 },
 "bobo-1ad1b0d646": {
  "text": "Kuz boshlanadigan kun.",
  "voice": "bobo",
  "file": "audio/uz/bobo-1ad1b0d646.mp3",
  "sec": 2.04
 },
 "bobo-f9031001d9": {
  "text": "A, L, K, T, I. Qaysi so'z chiqadi?",
  "voice": "bobo",
  "file": "audio/uz/bobo-f9031001d9.mp3",
  "sec": 2.78
 },
 "bobo-79e90054d1": {
  "text": "Rasmga qara. Darvozani nima ochadi?",
  "voice": "bobo",
  "file": "audio/uz/bobo-79e90054d1.mp3",
  "sec": 3.1
 },
 "bobo-7d143e9e86": {
  "text": "T, O. Qaysi so'z chiqadi?",
  "voice": "bobo",
  "file": "audio/uz/bobo-7d143e9e86.mp3",
  "sec": 1.8
 },
 "bobo-18b5d78b0d": {
  "text": "Rasmdagi hayvon nomini ayt.",
  "voice": "bobo",
  "file": "audio/uz/bobo-18b5d78b0d.mp3",
  "sec": 2.33
 },
 "bobo-50c3a097d1": {
  "text": "Y, U. Qaysi so'z chiqadi?",
  "voice": "bobo",
  "file": "audio/uz/bobo-50c3a097d1.mp3",
  "sec": 2.06
 },
 "bobo-e2be809e5d": {
  "text": "Biz unda yashaymiz.",
  "voice": "bobo",
  "file": "audio/uz/bobo-e2be809e5d.mp3",
  "sec": 1.58
 },
 "bobo-98ea861e7a": {
  "text": "Oq uyda sariq qiz o'tiradi. Bu nima?",
  "voice": "bobo",
  "file": "audio/uz/bobo-98ea861e7a.mp3",
  "sec": 2.76
 },
 "bobo-70028f67d7": {
  "text": "Uni tovuq beradi.",
  "voice": "bobo",
  "file": "audio/uz/bobo-70028f67d7.mp3",
  "sec": 1.92
 },
 "bobo-5f117d7169": {
  "text": "Kechasi chiqadi, yerga nur sochadi. Bu nima?",
  "voice": "bobo",
  "file": "audio/uz/bobo-5f117d7169.mp3",
  "sec": 3.38
 },
 "bobo-429ff1bd3d": {
  "text": "Osmonga qara. U kunduzi ko'rinmaydi.",
  "voice": "bobo",
  "file": "audio/uz/bobo-429ff1bd3d.mp3",
  "sec": 3.1
 },
 "bobo-d8c6571f35": {
  "text": "Tili yo'q, gapiradi. Ko'zi yo'q, ko'rsatadi. Bu nima?",
  "voice": "bobo",
  "file": "audio/uz/bobo-d8c6571f35.mp3",
  "sec": 4.08
 },
 "bobo-33a8d4c166": {
  "text": "Dev shuni o'g'irlab ketgan.",
  "voice": "bobo",
  "file": "audio/uz/bobo-33a8d4c166.mp3",
  "sec": 2.16
 },
 "bobo-3f1ebb4464": {
  "text": "Har bir jonivor qayerda yashashini esla.",
  "voice": "bobo",
  "file": "audio/uz/bobo-3f1ebb4464.mp3",
  "sec": 3.29
 },
 "bobo-ea753dc2a3": {
  "text": "Uzun quloq, kalta dum. Sabzi yeydi. Bu kim?",
  "voice": "bobo",
  "file": "audio/uz/bobo-ea753dc2a3.mp3",
  "sec": 3.24
 },
 "bobo-7ac8908863": {
  "text": "U juda tez sakraydi.",
  "voice": "bobo",
  "file": "audio/uz/bobo-7ac8908863.mp3",
  "sec": 1.97
 },
 "bobo-1bc408f729": {
  "text": "Ignalari bor, kechasi yuradi. Bu kim?",
  "voice": "bobo",
  "file": "audio/uz/bobo-1bc408f729.mp3",
  "sec": 3.0
 },
 "bobo-685e006a1b": {
  "text": "U xavf bo'lsa, to'p bo'lib o'raladi.",
  "voice": "bobo",
  "file": "audio/uz/bobo-685e006a1b.mp3",
  "sec": 2.71
 },
 "bobo-4f91aed493": {
  "text": "Daraxtda yashaydi, yong'oq yig'adi. Bu kim?",
  "voice": "bobo",
  "file": "audio/uz/bobo-4f91aed493.mp3",
  "sec": 3.36
 },
 "bobo-03a58d8ef3": {
  "text": "Dumi momiq, rangi malla.",
  "voice": "bobo",
  "file": "audio/uz/bobo-03a58d8ef3.mp3",
  "sec": 2.11
 },
 "bobo-86a7c56a23": {
  "text": "Qaysi so'z to'g'ri yozilgan?",
  "voice": "bobo",
  "file": "audio/uz/bobo-86a7c56a23.mp3",
  "sec": 2.35
 },
 "bobo-f43a68ec11": {
  "text": "Oxirgi harfni sekin ayt.",
  "voice": "bobo",
  "file": "audio/uz/bobo-f43a68ec11.mp3",
  "sec": 2.11
 },
 "bobo-b2b4ddd590": {
  "text": "Qaysi hayvon tuxum qo'yadi?",
  "voice": "bobo",
  "file": "audio/uz/bobo-b2b4ddd590.mp3",
  "sec": 2.21
 },
 "bobo-6ada589522": {
  "text": "U katakda yashaydi.",
  "voice": "bobo",
  "file": "audio/uz/bobo-6ada589522.mp3",
  "sec": 1.85
 },
 "bobo-05173c5910": {
  "text": "Bahorda daraxtda nima paydo bo'ladi?",
  "voice": "bobo",
  "file": "audio/uz/bobo-05173c5910.mp3",
  "sec": 2.86
 },
 "bobo-66aea7169d": {
  "text": "U chiroyli va xushbo'y.",
  "voice": "bobo",
  "file": "audio/uz/bobo-66aea7169d.mp3",
  "sec": 2.21
 },
 "bobo-cdb0649380": {
  "text": "Har bir buyum qaysi to'siqni yenggan edi?",
  "voice": "bobo",
  "file": "audio/uz/bobo-cdb0649380.mp3",
  "sec": 3.31
 },
 "bobo-f9cd759603": {
  "text": "Quyosh qaysi tomondan chiqadi?",
  "voice": "bobo",
  "file": "audio/uz/bobo-f9cd759603.mp3",
  "sec": 2.42
 },
 "bobo-511e2f7d96": {
  "text": "Ertalab quyoshga qarab tur.",
  "voice": "bobo",
  "file": "audio/uz/bobo-511e2f7d96.mp3",
  "sec": 2.18
 },
 "bobo-52ca2a2370": {
  "text": "Cho'lda nima ko'p?",
  "voice": "bobo",
  "file": "audio/uz/bobo-52ca2a2370.mp3",
  "sec": 1.97
 },
 "bobo-0ce981478c": {
  "text": "Oyog'ing botib ketadigan sariq zarralar.",
  "voice": "bobo",
  "file": "audio/uz/bobo-0ce981478c.mp3",
  "sec": 3.34
 },
 "bobo-72dbb5478a": {
  "text": "Qaysi hayvon suvsiz ko'p yura oladi?",
  "voice": "bobo",
  "file": "audio/uz/bobo-72dbb5478a.mp3",
  "sec": 2.9
 },
 "bobo-b4951d1d23": {
  "text": "Uning orqasida o'rkachi bor.",
  "voice": "bobo",
  "file": "audio/uz/bobo-b4951d1d23.mp3",
  "sec": 2.28
 },
 "bobo-3810881940": {
  "text": "Cho'lda yuradi, o'rkachi bor",
  "voice": "bobo",
  "file": "audio/uz/bobo-3810881940.mp3",
  "sec": 2.28
 },
 "bobo-b22da5d544": {
  "text": "Cho'lda oyoq botadi",
  "voice": "bobo",
  "file": "audio/uz/bobo-b22da5d544.mp3",
  "sec": 1.9
 },
 "bobo-e117039c2e": {
  "text": "Meshga nima solamiz?",
  "voice": "bobo",
  "file": "audio/uz/bobo-e117039c2e.mp3",
  "sec": 2.02
 },
 "bobo-97b6ff3148": {
  "text": "Kechasi osmonda yonadi",
  "voice": "bobo",
  "file": "audio/uz/bobo-97b6ff3148.mp3",
  "sec": 2.11
 },
 "bobo-d7a50fb931": {
  "text": "Tunda yo'l ko'rsatadi",
  "voice": "bobo",
  "file": "audio/uz/bobo-d7a50fb931.mp3",
  "sec": 1.85
 },
 "bobo-08e396b4fc": {
  "text": "Qatorni davom ettir: 🔴🔵🔴🔵🔴 ...",
  "voice": "bobo",
  "file": "audio/uz/bobo-08e396b4fc.mp3",
  "sec": 5.66
 },
 "bobo-5f0172291c": {
  "text": "Ranglar navbatma-navbat keladi.",
  "voice": "bobo",
  "file": "audio/uz/bobo-5f0172291c.mp3",
  "sec": 2.5
 },
 "bobo-61454ee156": {
  "text": "Qaysi biri ortiqcha: olma, nok, sabzi, uzum?",
  "voice": "bobo",
  "file": "audio/uz/bobo-61454ee156.mp3",
  "sec": 3.53
 },
 "bobo-b1ebc79c9d": {
  "text": "Uchtasi meva, bittasi sabzavot.",
  "voice": "bobo",
  "file": "audio/uz/bobo-b1ebc79c9d.mp3",
  "sec": 2.5
 },
 "bobo-fda5ef53f2": {
  "text": "2, 4, 6, 8 ... Keyingisi qaysi?",
  "voice": "bobo",
  "file": "audio/uz/bobo-fda5ef53f2.mp3",
  "sec": 3.48
 },
 "bobo-36cea21e22": {
  "text": "Har safar 2 ga oshadi.",
  "voice": "bobo",
  "file": "audio/uz/bobo-36cea21e22.mp3",
  "sec": 2.21
 },
 "bobo-f4cf6e02a7": {
  "text": "Choy damlash qadamlarini tartibla",
  "voice": "bobo",
  "file": "audio/uz/bobo-f4cf6e02a7.mp3",
  "sec": 2.93
 },
 "bobo-eee73ceacf": {
  "text": "Avval suv qaynashi kerak.",
  "voice": "bobo",
  "file": "audio/uz/bobo-eee73ceacf.mp3",
  "sec": 1.97
 },
 "bobo-456baf11c8": {
  "text": "Endi yonib turgan joyni bos.",
  "voice": "bobo",
  "file": "audio/uz/bobo-456baf11c8.mp3",
  "sec": 2.38
 },
 "bobo-20b98bd041": {
  "text": "Yana bir oz yaqinroq olib bor.",
  "voice": "bobo",
  "file": "audio/uz/bobo-20b98bd041.mp3",
  "sec": 2.33
 },
 "bobo-b135fb772c": {
  "text": "Avval sumkadagi kalitni ol.",
  "voice": "bobo",
  "file": "audio/uz/bobo-b135fb772c.mp3",
  "sec": 1.87
 },
 "bobo-567d3ba630": {
  "text": "Avval sumkadagi mash'alni ol.",
  "voice": "bobo",
  "file": "audio/uz/bobo-567d3ba630.mp3",
  "sec": 2.33
 },
 "bobo-c838daa3b7": {
  "text": "Avval sumkadagi qayiqni ol.",
  "voice": "bobo",
  "file": "audio/uz/bobo-c838daa3b7.mp3",
  "sec": 2.02
 },
 "bobo-167f69f575": {
  "text": "Avval sumkadagi ot va suv meshini ol.",
  "voice": "bobo",
  "file": "audio/uz/bobo-167f69f575.mp3",
  "sec": 3.0
 },
 "bobo-54cd1122e1": {
  "text": "Avval sumkadagi arqonni ol.",
  "voice": "bobo",
  "file": "audio/uz/bobo-54cd1122e1.mp3",
  "sec": 2.16
 },
 "bobo-f1d8f7c6e1": {
  "text": "Avval sumkadagi qilich va qalqonni ol.",
  "voice": "bobo",
  "file": "audio/uz/bobo-f1d8f7c6e1.mp3",
  "sec": 2.66
 },
 "bobo-dd0b4721d4": {
  "text": "Avval sumkadagi sehrli kalit-tumorni ol.",
  "voice": "bobo",
  "file": "audio/uz/bobo-dd0b4721d4.mp3",
  "sec": 3.22
 },
 "bobo-e76316f7ec": {
  "text": "Hali hech biri o'z joyida emas. Almashtirib ko'r!",
  "voice": "bobo",
  "file": "audio/uz/bobo-e76316f7ec.mp3",
  "sec": 3.86
 },
 "bobo-d13eb94b9d": {
  "text": "1 tasi o'z joyida. Qolganini almashtirib ko'r!",
  "voice": "bobo",
  "file": "audio/uz/bobo-d13eb94b9d.mp3",
  "sec": 3.7
 },
 "bobo-3458d40f02": {
  "text": "2 tasi o'z joyida. Qolganini almashtirib ko'r!",
  "voice": "bobo",
  "file": "audio/uz/bobo-3458d40f02.mp3",
  "sec": 3.96
 },
 "bobo-eb935f5f88": {
  "text": "3 tasi o'z joyida. Qolganini almashtirib ko'r!",
  "voice": "bobo",
  "file": "audio/uz/bobo-eb935f5f88.mp3",
  "sec": 3.77
 },
 "bobo-2c32a56131": {
  "text": "4 tasi o'z joyida. Qolganini almashtirib ko'r!",
  "voice": "bobo",
  "file": "audio/uz/bobo-2c32a56131.mp3",
  "sec": 3.86
 },
 "bobo-fb55b06056": {
  "text": "5 tasi o'z joyida. Qolganini almashtirib ko'r!",
  "voice": "bobo",
  "file": "audio/uz/bobo-fb55b06056.mp3",
  "sec": 3.91
 },
 "bobo-02d2fa9a44": {
  "text": "6 tasi o'z joyida. Qolganini almashtirib ko'r!",
  "voice": "bobo",
  "file": "audio/uz/bobo-02d2fa9a44.mp3",
  "sec": 3.86
 },
 "bobo-dc4581f29b": {
  "text": "7 tasi o'z joyida. Qolganini almashtirib ko'r!",
  "voice": "bobo",
  "file": "audio/uz/bobo-dc4581f29b.mp3",
  "sec": 3.98
 },
 "dev-b7a154d5df": {
  "text": "3 + 4 nechaga teng?",
  "voice": "dev",
  "file": "audio/uz/dev-b7a154d5df.mp3",
  "sec": 3.41
 },
 "dev-27bddc59c5": {
  "text": "Qaysi biri meva?",
  "voice": "dev",
  "file": "audio/uz/dev-27bddc59c5.mp3",
  "sec": 2.86
 },
 "dev-d87d0c379a": {
  "text": "Tuya qayerda yashaydi?",
  "voice": "dev",
  "file": "audio/uz/dev-d87d0c379a.mp3",
  "sec": 2.64
 },
 "dev-251ae2a7e7": {
  "text": "Qaysi harf unli?",
  "voice": "dev",
  "file": "audio/uz/dev-251ae2a7e7.mp3",
  "sec": 2.93
 },
 "dev-424e8ff843": {
  "text": "Bir haftada necha kun bor?",
  "voice": "dev",
  "file": "audio/uz/dev-424e8ff843.mp3",
  "sec": 2.78
 },
 "dev-f9cd759603": {
  "text": "Quyosh qaysi tomondan chiqadi?",
  "voice": "dev",
  "file": "audio/uz/dev-f9cd759603.mp3",
  "sec": 3.5
 },
 "dev-c941ed4220": {
  "text": "12 × 12 = ?",
  "voice": "dev",
  "file": "audio/uz/dev-c941ed4220.mp3",
  "sec": 4.2
 },
 "dev-a077bfdc8d": {
  "text": "O'simlikda fotosintez asosan qayerda bo'ladi?",
  "voice": "dev",
  "file": "audio/uz/dev-a077bfdc8d.mp3",
  "sec": 5.02
 },
 "dev-89e4bfc0ad": {
  "text": "'Apple' so'zining tarjimasi?",
  "voice": "dev",
  "file": "audio/uz/dev-89e4bfc0ad.mp3",
  "sec": 3.26
 },
 "dev-41c5092913": {
  "text": "Dunyodagi eng katta okean qaysi?",
  "voice": "dev",
  "file": "audio/uz/dev-41c5092913.mp3",
  "sec": 3.94
 },
 "dev-aee0d4374e": {
  "text": "Registon maydoni qaysi shaharda?",
  "voice": "dev",
  "file": "audio/uz/dev-aee0d4374e.mp3",
  "sec": 3.65
 },
 "dev-bdbb9644fd": {
  "text": "Uchburchak ichki burchaklari yig'indisi necha gradus?",
  "voice": "dev",
  "file": "audio/uz/dev-bdbb9644fd.mp3",
  "sec": 6.29
 },
 "dev-4ca8c8a977": {
  "text": "√144 = ?",
  "voice": "dev",
  "file": "audio/uz/dev-4ca8c8a977.mp3",
  "sec": 6.0
 },
 "dev-7a630f5955": {
  "text": "Suvning kimyoviy formulasi qaysi?",
  "voice": "dev",
  "file": "audio/uz/dev-7a630f5955.mp3",
  "sec": 4.06
 },
 "dev-51e8cef8aa": {
  "text": "Vakuumda yorug'lik tezligi taxminan qancha?",
  "voice": "dev",
  "file": "audio/uz/dev-51e8cef8aa.mp3",
  "sec": 5.06
 },
 "dev-865801b4ba": {
  "text": "Mendeleyev jadvalidagi 1-element?",
  "voice": "dev",
  "file": "audio/uz/dev-865801b4ba.mp3",
  "sec": 4.85
 },
 "dev-5f78aba8f2": {
  "text": "\"Xamsa\" dostonlar turkumi muallifi?",
  "voice": "dev",
  "file": "audio/uz/dev-5f78aba8f2.mp3",
  "sec": 4.06
 },
 "dev-0f860f1452": {
  "text": "O'nlik sistemadagi 8 soni ikkilik sistemada qanday yoziladi?",
  "voice": "dev",
  "file": "audio/uz/dev-0f860f1452.mp3",
  "sec": 7.63
 },
 "dev-abf8755778": {
  "text": "DNK eukariot hujayrada asosan qayerda joylashgan?",
  "voice": "dev",
  "file": "audio/uz/dev-abf8755778.mp3",
  "sec": 6.29
 },
 "dev-edca2c34c9": {
  "text": "Ekvatorda yil davomida kun va tun uzunligi qanday?",
  "voice": "dev",
  "file": "audio/uz/dev-edca2c34c9.mp3",
  "sec": 5.64
 },
 "dev-5742024397": {
  "text": "Ho-ho! Bilim kitobini olmoqchimisan? Avval savollarimga javob ber!",
  "voice": "dev",
  "file": "audio/uz/dev-5742024397.mp3",
  "sec": 7.85
 },
 "dev-06e804494c": {
  "text": "Kechiring! Kitobni qaytaraman, endi yaxshi bo'laman!",
  "voice": "dev",
  "file": "audio/uz/dev-06e804494c.mp3",
  "sec": 6.05
 },
 "dev-31a99f2bc4": {
  "text": "Voy-voy! Bilimning kuchi mendan ham kuchli ekan!",
  "voice": "dev",
  "file": "audio/uz/dev-31a99f2bc4.mp3",
  "sec": 5.52
 },
 "bobo-7ef891daa3": {
  "text": "Ajoyib! Avval kalitni top, keyin darvozaga bor.",
  "voice": "bobo",
  "file": "audio/uz/bobo-7ef891daa3.mp3",
  "sec": 3.79
 },
 "bobo-4880aebcbe": {
  "text": "Atrofga diqqat bilan qara. Ro'yxatdagi buyumlarni rasmdan top.",
  "voice": "bobo",
  "file": "audio/uz/bobo-4880aebcbe.mp3",
  "sec": 5.04
 },
 "bobo-c5aceca975": {
  "text": "To'siqqa yaqinlashganda sakra! Shoshilma, har urinish seni kuchliroq qiladi.",
  "voice": "bobo",
  "file": "audio/uz/bobo-c5aceca975.mp3",
  "sec": 6.22
 },
 "bobo-d8392c1932": {
  "text": "Har bir jumboq bitta raqamni yashirgan. Ularni birma-bir yech.",
  "voice": "bobo",
  "file": "audio/uz/bobo-d8392c1932.mp3",
  "sec": 5.06
 },
 "bobo-babde7d223": {
  "text": "Kalit topildi! Endi darvozaga bor.",
  "voice": "bobo",
  "file": "audio/uz/bobo-babde7d223.mp3",
  "sec": 2.98
 },
 "bobo-6467b21a1f": {
  "text": "Darvoza yopiq. Avval oltin kalitni top.",
  "voice": "bobo",
  "file": "audio/uz/bobo-6467b21a1f.mp3",
  "sec": 3.17
 },
 "bobo-435aa7e199": {
  "text": "Ehtiyot bo'l, tuzoq! Boshqa yo'ldan yur.",
  "voice": "bobo",
  "file": "audio/uz/bobo-435aa7e199.mp3",
  "sec": 3.05
 },
 "bobo-56240d9083": {
  "text": "Hozir sakra! Katta tugmani bos.",
  "voice": "bobo",
  "file": "audio/uz/bobo-56240d9083.mp3",
  "sec": 2.47
 },
 "bobo-01602d22c0": {
  "text": "Hechqisi yo'q! Yana urinib ko'r.",
  "voice": "bobo",
  "file": "audio/uz/bobo-01602d22c0.mp3",
  "sec": 2.4
 },
 "bobo-1566241d64": {
  "text": "Qara, yerdagi oltin belgida sakra.",
  "voice": "bobo",
  "file": "audio/uz/bobo-1566241d64.mp3",
  "sec": 2.86
 },
 "bobo-f4d02d4d36": {
  "text": "Sandiq ochildi! Aqlingga balli, bolam!",
  "voice": "bobo",
  "file": "audio/uz/bobo-f4d02d4d36.mp3",
  "sec": 2.66
 },
 "bobo-82d70e4ee1": {
  "text": "Bu yerda emas. Yana diqqat bilan qara.",
  "voice": "bobo",
  "file": "audio/uz/bobo-82d70e4ee1.mp3",
  "sec": 2.95
 },
 "bobo-f99edfd10c": {
  "text": "Kuch emas, bilim g'alaba keltiradi!",
  "voice": "bobo",
  "file": "audio/uz/bobo-f99edfd10c.mp3",
  "sec": 2.88
 },
 "bobo-9674e3c273": {
  "text": "Dev sehr otyapti! Shar yaqinlashganda qalqonni ko'tar.",
  "voice": "bobo",
  "file": "audio/uz/bobo-9674e3c273.mp3",
  "sec": 4.44
 },
 "bobo-f58983a9c4": {
  "text": "Endi sehrli belgilarni to'g'ri tartibda bos.",
  "voice": "bobo",
  "file": "audio/uz/bobo-f58983a9c4.mp3",
  "sec": 3.58
 },
 "bobo-be2aa9b273": {
  "text": "Shoshilma, shar yaqinroq kelsin.",
  "voice": "bobo",
  "file": "audio/uz/bobo-be2aa9b273.mp3",
  "sec": 2.59
 },
 "bobo-a237625248": {
  "text": "Belgilarga yana bir bor diqqat bilan qara.",
  "voice": "bobo",
  "file": "audio/uz/bobo-a237625248.mp3",
  "sec": 3.48
 },
 "bobo-0529cf0a4f": {
  "text": "Yonib turgan yo'l bo'ylab yur.",
  "voice": "bobo",
  "file": "audio/uz/bobo-0529cf0a4f.mp3",
  "sec": 2.26
 },
 "bobo-3184e7f3a9": {
  "text": "Rasmni diqqat bilan ko'zdan kechir.",
  "voice": "bobo",
  "file": "audio/uz/bobo-3184e7f3a9.mp3",
  "sec": 2.93
 },
 "bobo-623d8eff7b": {
  "text": "Xoda yaqinlashganda sakra.",
  "voice": "bobo",
  "file": "audio/uz/bobo-623d8eff7b.mp3",
  "sec": 2.33
 },
 "bobo-c83a6c4d4b": {
  "text": "4 + 3 = ?",
  "voice": "bobo",
  "file": "audio/uz/bobo-c83a6c4d4b.mp3",
  "sec": 2.5
 },
 "bobo-96201db751": {
  "text": "9 − 5 = ?",
  "voice": "bobo",
  "file": "audio/uz/bobo-96201db751.mp3",
  "sec": 2.64
 },
 "bobo-04a5a3a15e": {
  "text": "To'qqiztadan beshtasini olib qo'y.",
  "voice": "bobo",
  "file": "audio/uz/bobo-04a5a3a15e.mp3",
  "sec": 3.02
 },
 "bobo-67e8ad0bb9": {
  "text": "15 − 7 = ?",
  "voice": "bobo",
  "file": "audio/uz/bobo-67e8ad0bb9.mp3",
  "sec": 2.74
 },
 "bobo-d113c02fa8": {
  "text": "O'n beshdan avval beshni, keyin ikkini ayir.",
  "voice": "bobo",
  "file": "audio/uz/bobo-d113c02fa8.mp3",
  "sec": 3.48
 },
 "bobo-2c87ff3751": {
  "text": "Hali hech bir raqam to'g'ri emas. Jumboqlarni qayta yech.",
  "voice": "bobo",
  "file": "audio/uz/bobo-2c87ff3751.mp3",
  "sec": 4.7
 },
 "bobo-1dca100d54": {
  "text": "1 ta raqam to'g'ri. Qolganini tekshir.",
  "voice": "bobo",
  "file": "audio/uz/bobo-1dca100d54.mp3",
  "sec": 3.1
 },
 "bobo-aca2665223": {
  "text": "2 ta raqam to'g'ri. Qolganini tekshir.",
  "voice": "bobo",
  "file": "audio/uz/bobo-aca2665223.mp3",
  "sec": 3.36
 },
 "bobo-433ac2295c": {
  "text": "3 ta raqam to'g'ri. Qolganini tekshir.",
  "voice": "bobo",
  "file": "audio/uz/bobo-433ac2295c.mp3",
  "sec": 3.17
 },
 "bobo-c55be8a603": {
  "text": "4 ta raqam to'g'ri. Qolganini tekshir.",
  "voice": "bobo",
  "file": "audio/uz/bobo-c55be8a603.mp3",
  "sec": 3.5
 },
 "dev-dc5e3ec8fe": {
  "text": "Mana, sehrimni qaytar-chi!",
  "voice": "dev",
  "file": "audio/uz/dev-dc5e3ec8fe.mp3",
  "sec": 3.1
 },
 "dev-d91cf45cd2": {
  "text": "Sehrli belgilarimni hech kim topa olmaydi!",
  "voice": "dev",
  "file": "audio/uz/dev-d91cf45cd2.mp3",
  "sec": 4.94
 }
}