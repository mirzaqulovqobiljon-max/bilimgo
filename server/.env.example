# PostgreSQL ulanishi
DATABASE_URL=postgres://ipak:ipak@localhost:5432/ipak_yoli
# Server porti
PORT=8080
# O'qituvchilar ro'yxatdan o'tishi uchun taklif kodi (maktab ma'muriyati beradi). Bo'sh bo'lsa — cheklovsiz.
TEACHER_INVITE=
# Sinfning jamoaviy maqsadi (yulduz)
CLASS_GOAL_STARS=500
